{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": ["config:recommended", ":maintainLockFilesWeekly"],

  "prHourlyLimit": 0,
  "prConcurrentLimit": 3,

  "packageRules": [
    {
      "matchPackageNames": ["nuxt", "@nuxt/content", "vue", "mongoose"],
      "groupName": "nuxt ecosystem"
    },
    {
      "matchManagers": ["pnpm"],
      "enabled": true
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
